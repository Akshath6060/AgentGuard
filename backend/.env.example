APP_ENV=development
LOG_LEVEL=INFO
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=agentguard
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
JWT_ISSUER=agentguard
JWT_AUDIENCE=agentguard-console
FRONTEND_URL=http://localhost:5173
# Comma-separated. In production, every origin must use HTTPS.
ALLOWED_ORIGINS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MODE=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_POLICY_PROVIDER=mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
MONGODB_VECTOR_INDEX=policy_chunks_vector
AI_RATE_LIMIT_PER_MINUTE=30
